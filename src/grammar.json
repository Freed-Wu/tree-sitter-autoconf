{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "autoconf",
  "rules": {
    "file": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_statements"
        },
        {
          "type": "BLANK"
        }
      ]
    },
    "_statements": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "macro_call"
        },
        {
          "type": "SYMBOL",
          "name": "bare_macro"
        },
        {
          "type": "SYMBOL",
          "name": "m4_quoted"
        },
        {
          "type": "SYMBOL",
          "name": "code"
        },
        {
          "type": "PATTERN",
          "value": "\\s+"
        }
      ]
    },
    "comment": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "dnl"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t\\v]*"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[^\\n]*"
            },
            "named": true,
            "value": "body"
          }
        ]
      }
    },
    "macro_call": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "PREC_RIGHT",
        "value": 0,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "name",
              "content": {
                "type": "SYMBOL",
                "name": "macro_name"
              }
            },
            {
              "type": "STRING",
              "value": "("
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "FIELD",
                  "name": "arguments",
                  "content": {
                    "type": "SYMBOL",
                    "name": "argument_list"
                  }
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "STRING",
              "value": ")"
            }
          ]
        }
      }
    },
    "bare_macro": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "macro_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n"
            },
            {
              "type": "SYMBOL",
              "name": "comment"
            }
          ]
        }
      ]
    },
    "argument_list": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "m4_quoted"
          },
          {
            "type": "SYMBOL",
            "name": "macro_call"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_argument_text"
            },
            "named": true,
            "value": "code"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_parenthesized_text"
            },
            "named": true,
            "value": "code"
          },
          {
            "type": "STRING",
            "value": ","
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    },
    "_argument": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "m4_quoted"
          },
          {
            "type": "SYMBOL",
            "name": "macro_call"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_argument_text"
            },
            "named": true,
            "value": "code"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_parenthesized_text"
            },
            "named": true,
            "value": "code"
          }
        ]
      }
    },
    "m4_quoted": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC",
          "value": 2,
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "[["
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "SYMBOL",
                      "name": "_double_quoted_text"
                    },
                    "named": true,
                    "value": "code"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "STRING",
                "value": "]]"
              }
            ]
          }
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "["
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "m4_quoted"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "macro_call"
                  },
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "SYMBOL",
                      "name": "_quoted_text"
                    },
                    "named": true,
                    "value": "code"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "]"
            }
          ]
        }
      ]
    },
    "macro_name": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "PATTERN",
        "value": "AC_[A-Z0-9_]+|AS_[A-Z0-9_]+|AH_[A-Z0-9_]+|AM_[A-Z0-9_]+|LT_[A-Z0-9_]+|PKG_[A-Z0-9_]+|AX_[A-Z0-9_]+|zsh_[A-Z0-9_]+|m4_[A-Za-z0-9_]+|ifdef|ifndef|ifelse|undefine|include|sinclude|esyscmd|changequote|changecom"
      }
    },
    "code": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\[\\]\\n]+"
        }
      }
    },
    "_quoted_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\[\\]\\n]+"
        }
      }
    },
    "_double_quoted_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "([^\\]]|\\][^\\]])+"
        }
      }
    },
    "_argument_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^,()\\[\\]\\n]+"
        }
      }
    },
    "_parenthesized_text": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_argument_text"
                },
                "named": true,
                "value": "code"
              },
              {
                "type": "SYMBOL",
                "name": "_parenthesized_text"
              },
              {
                "type": "SYMBOL",
                "name": "m4_quoted"
              },
              {
                "type": "STRING",
                "value": ","
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "PATTERN",
      "value": "\\\\\\r?\\n"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "PATTERN",
      "value": "\\\\( |\\t|\\v|\\f)"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}